{
  "name": "qris-api",
  "version": "1.0.0",
  "description": "API konversi QRIS statis ke dinamis",
  "main": "dist/app.js",
  "module": "src/app.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/app.ts",
    "dev": "bun --watch src/app.ts",
    "build": "bun build src/app.ts --target bun --outdir dist"
  },
  "resolutions": {
    "**/typescript": "^5.6.2"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.1.0",
    "@elysiajs/cors": "^1.1.0",
    "elysia": "^1.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "bun-types": "latest",
    "@types/qrcode": "^1.5.5"
  }
}
